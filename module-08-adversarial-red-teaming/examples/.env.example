# Module 8 — Adversarial Testing & Red-Teaming
# Environment variables
# Copy this file to examples/.env and fill in real values.
# Never commit .env.
#
# target_agent.py loads .env from its own directory (examples/).
# Notebooks import from target_agent.py and inherit the same env.

# Provider selection: "azure" (default), "openai", or "ollama".
# Same switch as Modules 4-7.
PROVIDER=azure

# Azure OpenAI — used when PROVIDER=azure
AZURE_OPENAI_ENDPOINT_C=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2

# OpenAI — used when PROVIDER=openai
DEMO_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here

# Ollama — used when PROVIDER=ollama
# Pull the model first: `ollama pull llama3.2:3b`
OLLAMA_BASE_URL=http://localhost:11434/v1

# DeepEval / Confident AI — required for RedTeamer.scan() (Day 2).
# Sign up at https://app.confident-ai.com to get this key.
# Day 1 (GEval injection-resistance metric) does NOT require this key —
# GEval runs locally using your LLM provider above.
DEEPEVAL_API_KEY=your-deepeval-key-here

# LangSmith tracing — same pattern as Modules 5-7.
# Every call_agent() invocation sends a trace here.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=module-08-adversarial-red-teaming
