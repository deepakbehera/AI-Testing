# ── Provider selection ───────────────────────────────────────────────────────
# Set PROVIDER to whichever backend you want to use: azure | openai | ollama
PROVIDER=azure

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Get these from the Azure AI Foundry portal → your deployment → Keys and Endpoint
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2

# ── Deep Eval Azure OpenAI model & deployment ─────────────────────────────────────────
USE_AZURE_OPENAI=1
AZURE_MODEL_NAME=DeepSeek-V3.2
AZURE_DEPLOYMENT_NAME=DeepSeek-V3.2
AZURE_OPENAI_ENDPOINT=https://ai-testing-apr-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key-here
OPENAI_API_VERSION=2025-01-01-preview

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Run: ollama serve   (starts the server)
# Run: ollama pull llama3.2:3b   (downloads the model)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ── DeepEval judge model ─────────────────────────────────────────────────────
# DeepEval's LLM-as-a-judge always routes through OpenAI.
# Fill OPENAI_API_KEY above even if your app model uses Azure or Ollama.
DEEPEVAL_API_KEY=
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini
