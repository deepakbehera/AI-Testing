# ── Judge model (used by DeepEval to evaluate responses) ─────────────────────
# DeepEval uses this to power AnswerRelevancy, Faithfulness, Hallucination, etc.
OPENAI_API_KEY=sk-...

# ── Model under test (the LLM whose responses you're evaluating) ──────────────
# Can be different from the judge model
PROVIDER=ollama          # options: ollama | openai | anthropic
DEMO_MODEL=llama3.2:3b   # model name for the tested LLM

# ── Ollama (if running locally) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── DeepEval Confident AI (optional — for the hosted dashboard) ───────────────
# Get your key at https://app.confident-ai.com
DEEPEVAL_API_KEY=

# ── Judge model override (if you want a different judge than OPENAI) ──────────
# Leave blank to use OPENAI_API_KEY above
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini
