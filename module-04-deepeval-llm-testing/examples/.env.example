# ── Provider selection ───────────────────────────────────────────────────────
# Set PROVIDER to whichever backend you want to use: azure | openai | ollama
PROVIDER=azure
# PROVIDER=ollama

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_KEY=user-specific-key
AZURE_OPENAI_ENDPOINT_C=https://ai-testing-apr-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2

# ── Deep Eval Azure OpenAI model & deployment ─────────────────────────────────────────
USE_AZURE_OPENAI=1
AZURE_MODEL_NAME=DeepSeek-V3.2
AZURE_DEPLOYMENT_NAME=DeepSeek-V3.2
AZURE_OPENAI_ENDPOINT=https://ai-testing-apr-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=user-specific-key
OPENAI_API_VERSION=2025-01-01-preview


# ── Deep Eval Ollama model & deployment
# USE_OLLAMA=1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_API_KEY=llama3.2:3b

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini


# ── DeepEval judge model ─────────────────────────────────────────────────────
# DeepEval's LLM-as-a-judge always uses OpenAI. Fill OPENAI_API_KEY above
# even if your app model uses Azure or Ollama.
# DEEPEVAL_API_KEY=
# DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# ── Ollama (local) ───────────────────────────────────────────────────────────
# USE_AWS_BEDROCK_MODEL=0
# LOCAL_MODEL_NAME=llama3.2:3b
# OLLAMA_MODEL_NAME=llama3.2:3b
# USE_MOONSHOT_MODEL=0
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# USE_LOCAL_MODEL=1
# USE_AZURE_OPENAI=0
# LOCAL_MODEL_API_KEY=ollama
# USE_OPENROUTER_MODEL=0
# USE_ANTHROPIC_MODEL=0
# USE_GEMINI_MODEL=0
# USE_LITELLM=0
# USE_GROK_MODEL=0
# USE_OPENAI_MODEL=0
