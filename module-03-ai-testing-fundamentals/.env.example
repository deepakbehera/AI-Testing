# Module 3 — Environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Provider selection: "ollama" (default, free) or "openai"
PROVIDER=ollama

# Model to use in demos. Ollama default — llama3.2:3b. OpenAI default — gpt-4o-mini.
DEMO_MODEL=llama3.2:3b

# Temperature for variance probe (Day 1). Try 0.7 then 0.0.
TEMPERATURE=0.7

# Ollama base URL (default — local). Change if running Ollama elsewhere.
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI API key — required only if PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# Anthropic API key — optional, not used in this module's examples
ANTHROPIC_API_KEY=sk-ant-your-key-here
