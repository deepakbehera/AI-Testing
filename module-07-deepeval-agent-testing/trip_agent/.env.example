# trip_agent — copy this file to .env and fill in your credentials.
# Same PROVIDER switch as the rest of module 7. The MCP server it launches
# (../trip_mcp_server/server.py) needs no credentials — it hits the free
# open-meteo.com API.

# ─── Provider selection ────────────────────────────────────────────────────────
PROVIDER=azure

# ─── Azure AI Foundry (default) — trip_agent's own reasoning LLM ───────────────
AZURE_OPENAI_ENDPOINT_C=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2

# ─── OpenAI (direct) ───────────────────────────────────────────────────────────
# Used when PROVIDER=openai.
# OPENAI_API_KEY=your-openai-key-here
# DEMO_MODEL=gpt-4o-mini

# ─── Ollama (local) ────────────────────────────────────────────────────────────
# Used when PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# DEMO_MODEL=llama3.2:3b

# ─── DeepEval Azure OpenAI judge (used by ci/) ─────────────────────────────────
# USE_AZURE_OPENAI=1
# AZURE_MODEL_NAME=DeepSeek-V3.2
# AZURE_DEPLOYMENT_NAME=DeepSeek-V3.2
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key-here
# OPENAI_API_VERSION=2025-01-01-preview

# ─── LangSmith tracing (optional — visualizes MCP tool usage) ──────────────────
# Set LANGSMITH_TRACING=true and add your key to see each run as a trip_agent
# trace with MCP tool calls as nested spans in the LangSmith web UI.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=module-07-trip-agent
