# weather_agent — copy this file to .env and fill in your credentials.
# Same PROVIDER switch as ../examples/agent_tools.py and the rest of this course.
# No weather-API key needed — open-meteo.com is free and unauthenticated.

# ─── Provider selection ────────────────────────────────────────────────────────
PROVIDER=azure

# ─── Azure AI Foundry (default) — weather_agent's own reasoning LLM ────────────
AZURE_OPENAI_ENDPOINT_C=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2

# ─── OpenAI (direct) ───────────────────────────────────────────────────────────
# Used when PROVIDER=openai.
# OPENAI_API_KEY=your-openai-key-here
# DEMO_MODEL=gpt-4o-mini

# ─── Ollama (local) ────────────────────────────────────────────────────────────
# Used when PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# DEMO_MODEL=llama3.2:3b

# ─── DeepEval Azure OpenAI judge (optional) ────────────────────────────────────
# If set, every DeepEval metric in the Day 1/2 notebooks auto-uses Azure as its
# judge (deepeval.metrics.utils.should_use_azure_openai) — no model= needed.
# USE_AZURE_OPENAI=1
# AZURE_MODEL_NAME=DeepSeek-V3.2
# AZURE_DEPLOYMENT_NAME=DeepSeek-V3.2
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key-here
# OPENAI_API_VERSION=2025-01-01-preview
