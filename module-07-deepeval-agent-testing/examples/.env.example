# Module 7 — AI Agents Testing with DeepEval
# Copy this file to .env and fill in your credentials.
# Same PROVIDER switch as Modules 5 and 6.

# ─── Provider selection ────────────────────────────────────────────────────────
# Set PROVIDER to "azure" (default), "openai", or "ollama".
PROVIDER=azure


# ─── Azure AI Foundry (default) ────────────────────────────────────────────────
# Used when PROVIDER=azure.
AZURE_OPENAI_ENDPOINT_C=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2         # chat completion deployment name
# Note: Azure provider uses Mode.JSON_SCHEMA for instructor (structured outputs),
# since non-OpenAI models on Azure don't reliably emit OpenAI-style tool call JSON.
# The agent loop itself uses the standard tools/function-calling parameter — this
# only affects judge_client structured-output calls.


# ─── OpenAI (direct) ───────────────────────────────────────────────────────────
# Used when PROVIDER=openai.
OPENAI_API_KEY=your-openai-key-here
DEMO_MODEL=gpt-4o-mini                         # or gpt-4o, gpt-3.5-turbo, etc.


# ─── Ollama (local) ────────────────────────────────────────────────────────────
# Used when PROVIDER=ollama. Requires a running Ollama instance.
# Note: local models vary significantly in function-calling reliability.
# llama3.2:3b supports function calling but may be inconsistent on complex cases.
OLLAMA_BASE_URL=http://localhost:11434/v1
# DEMO_MODEL=llama3.2:3b


# ─── LangSmith tracing ─────────────────────────────────────────────────────────
# Module 5 introduced @traceable; Modules 6-7 extend it.
# In Module 7, each @traceable tool appears as its own LangSmith child span
# (run_type="tool") under the customer_service_agent parent trace.
# Set LANGSMITH_TRACING=true to enable; leave unset or false to disable.
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=module-07-deepeval-agent-testing


# ─── DeepEval (optional cloud dashboard) ───────────────────────────────────────
# DeepEval runs metric evaluation locally by default — no key required.
# Set DEEPEVAL_API_KEY only if you want results visible in the DeepEval
# cloud dashboard at https://app.deepeval.com.
# DEEPEVAL_API_KEY=your-deepeval-key-here
