# Module 6 — Environment variables
# Copy this file to examples/.env (agent.py loads it from its own directory —
# see the load_dotenv() call in examples/agent.py) and fill in real values.
# Never commit .env.
#
# Every cell that calls agentic_rag() makes real LLM + embedding calls — this
# is not optional setup the way it was when the planner/retriever were rule-based
# stand-ins.

# Provider selection: "azure" (default, matches Modules 4/5's shared resource),
# "openai", or "ollama" (free, local, needs `ollama pull` for a chat + embedding model).
PROVIDER=azure
AZURE_OPENAI_ENDPOINT_C=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=DeepSeek-V3.2
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# OpenAI (used only if PROVIDER=openai)
DEMO_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-your-key-here

# Ollama (used only if PROVIDER=ollama) — pull both models first:
# `ollama pull llama3.2:3b` and `ollama pull all-minilm`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBED_MODEL=all-minilm

# LangSmith tracing — same as Module 5 Day 3, now tracing multi-hop chains.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=module-06-agentic-rag-testing
