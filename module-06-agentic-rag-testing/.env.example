# Module 6 — Environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Provider selection: "ollama" (default, free) or "openai" — only needed if you
# swap the rule-based planner/retriever stubs for a real LLM-driven planner.
PROVIDER=ollama
DEMO_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-your-key-here

# LangSmith tracing — same as Module 5 Day 3, now tracing multi-hop chains.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=module-06-agentic-rag-testing
