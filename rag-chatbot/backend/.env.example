# ── Ollama ────────────────────────────────────────────────────
# Your Ollama server URL (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LLM Model ────────────────────────────────────────────────
# Model to use for answering questions (must be available in Ollama)
LLM_MODEL=llama3.2:3b

# ── Embedding Model ──────────────────────────────────────────
# Sentence-transformers model for generating embeddings
# Other options: all-mpnet-base-v2, multi-qa-MiniLM-L6-cos-v1
EMBED_MODEL=all-MiniLM-L6-v2
