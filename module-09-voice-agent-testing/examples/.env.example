# Module 9 — Voice Agent
# Copy this file to examples/.env and fill in real values. Never commit .env.
# voice_agent.py loads .env from its own directory.

# ── Required keys (both have free tiers) ────────────────────────────────────────
# Sarvam (ears + mouth): https://platform.sarvam.ai/  -> Dashboard -> API keys
SARVAM_API_KEY=your-sarvam-key-here
# Groq (the brain): https://console.groq.com/  -> API Keys
GROQ_API_KEY=your-groq-key-here

# ── Optional overrides (sensible defaults are baked into voice_agent.py) ─────────
# Sarvam speech-to-text model.
# SARVAM_STT_MODEL=saarika:v2.5
# Sarvam text-to-speech model + speaker. Valid speakers depend on the model —
# check the playground: https://platform.sarvam.ai/api-playground/
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_TTS_SPEAKER=anushka
# BCP-47 language for STT/TTS (e.g. en-IN, hi-IN, ta-IN, bn-IN).
# VOICE_LANGUAGE=en-IN
# Groq chat model — llama-3.1-8b-instant (fastest) or llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.1-8b-instant
