# Module 5 — Environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Provider selection: "ollama" (default, free) or "openai"
PROVIDER=ollama

# Judge/generator model for RAGAS metrics. Ollama default — llama3.2:3b. OpenAI default — gpt-4o-mini.
DEMO_MODEL=llama3.2:3b

# Embedding model — RAGAS needs embeddings for context precision/recall.
# OpenAI default below; for Ollama, pull an embedding model first: `ollama pull nomic-embed-text`
EMBEDDING_MODEL=text-embedding-3-small

# Ollama base URL (default — local). Change if running Ollama elsewhere.
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI API key — required only if PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# LangSmith tracing (Day 3) — free tier is enough for this module.
# Sign up at https://smith.langchain.com, then set:
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_PROJECT=module-05-ragas-rag-testing
